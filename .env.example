# SnapGen upstream credentials (web channel fallback account):
GENV_EMAIL=you@example.com
GENV_PASSWORD=yourpassword
# or a raw access token:
# GENV_TOKEN=eyJ...

# account pool file (web + app accounts; app entries have "platform":"GenV-APP"):
# GENV_POOL=accounts_pool.json
# refill app accounts:  python account_pool.py 10 --app   (or WebUI 一键补充)

# ---- gateway auth ----
# master/admin key: unrestricted, required for /admin/* and WebUI.
# GATEWAY_API_KEY=dev-master-key
# per-user keys are issued via WebUI / POST /admin/keys (models scope + limit).

# ---- honor pool (bot + api-key reserve) ----
# auto-provisioned GenV-APP accounts are tagged "honor"; when usable honor
# accounts drop below min_usable the background task auto-registers more.
# GENV_MIN_USABLE=3       # 0 disables threshold refills
# GENV_REFILL_BATCH=3
# GENV_FREE_GENS=5        # ad-free 0-credit gens assumed per fresh account
# GENV_STATE=gateway_state.json
# GENV_KEYS=keys.json

# ---- QQ bot (OneBot v11 reverse websocket) ----
# point NapCat/Lagrange reverse-WS to: ws://<host>:8400/onebot
# ONEBOT_TOKEN=           # must match the client's access_token, if set
# QQ_ADMIN=123456,654321  # qq ids allowed to run 补号

# HIGH_TRAFFIC auto-resubmit attempts per job (default 3):
# GENV_RESUBMIT=5

# PORT=8400
